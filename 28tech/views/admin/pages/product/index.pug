extends ../../layouts/default.pug

block main 
    h1 Danh sach san pham 

    .card.mb-3
        .card-header Bộ lọc và Tìm kiếm
            .card-body
                button(
                    class="btn btn-sm ml-1 btn-outline-success active"
                    button-status=""
                ) Tất cả
                button(
                    class="btn btn-sm ml-1 btn-outline-success"
                    button-status="active"
                ) Hoạt động
                button(
                    class="btn btn-sm ml-1 btn-outline-success"
                    button-status="inactive"
                ) Dừng hoạt động
    .card.mb-3
        .card-header Bộ lọc và Tìm kiếm
            .card-body
                table.table.table-hover.table-sm 
                    thead 
                        tr 
                            th STT 
                            th Hinh anh
                            th Tieu de 
                            th Gia 
                            th Trang thai 
                            th Hanh Dong 
                    tbody
                        // ✅ Corrected Loop Syntax
                        each item, i in products
                            tr 
                                td #{i + 1}
                                td 
                                    img(src=item.thumbnail, alt="Hinh anh san pham", width="100px", height="auto")
                                td #{item.title}
                                td #{item.price}$
                                td 
                                    if(item.status == "active")
                                        a(href="#" class="badge bg-success") Hoat Dong 
                                    else
                                        a(href="#" class="badge bg-danger") Dung hoat dong
                                td 
                                    button(class="btn btn-warning btn-sm") Sua
                                    button(class="btn btn-danger btn-sm ml-1") Xoa
    script(src="/admin/js/script.js") 
